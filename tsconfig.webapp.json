{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "vite.web.config.mts",
    "src/web/**/*",
    "src/renderer/src/**/*",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"]
    }
  }
}
