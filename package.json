{
  "name": "stella",
  "productName": "Stella",
  "version": "1.3.0",
  "description": "Create cards and other game components",
  "main": "./out/main/index.js",
  "author": "Luca Di Gialleonardo",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/lucadj77/stella",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:webapp": "tsc --noEmit -p tsconfig.webapp.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:webapp",
    "start": "electron-vite preview",
    "predev": "node scripts/dev-app-name.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "dev:web": "vite -c vite.web.config.mts",
    "build:web": "npm run typecheck && vite build -c vite.web.config.mts",
    "preview:web": "vite preview -c vite.web.config.mts",
    "demo-data": "node scripts/make-demo-data.mjs",
    "test": "vitest run",
    "stella": "node bin/stella.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "numfmt": "^3.2.6",
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "buffer": "^6.0.3",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fflate": "^0.8.3",
    "path-browserify": "^1.0.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "bin": {
    "stella": "bin/stella.mjs"
  }
}
